# All optional. Defaults shown.
HOST=0.0.0.0
PORT=8787
# Where the SQLite file (relay.sqlite) is written.
DATA_DIR=./data
# Serve the built web app from this directory on the same origin (e.g. ../web/dist).
STATIC_DIR=
# Comma-separated browser origins allowed to connect, e.g. https://notes.example.com. Empty = any.
ALLOWED_ORIGINS=
# Max size of one encrypted update or snapshot, in bytes of base64url text.
MAX_DATA_BYTES=1048576
MAX_SUBS_PER_PEER=10000
