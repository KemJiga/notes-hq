{
  "name": "@notes-hq/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Blind relay for notes-hq: stores and forwards encrypted sync updates.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node/main.ts",
    "build": "esbuild src/node/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/relay.mjs --external:ws",
    "start": "node --disable-warning=ExperimentalWarning dist/relay.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cloudflare.json",
    "test": "tsx --test test/*.test.ts",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "@notes-hq/protocol": "0.1.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
