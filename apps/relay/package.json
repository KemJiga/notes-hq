{
  "name": "@notes-hq/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Blind relay for notes-hq: stores and forwards encrypted sync updates.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/main.ts",
    "build": "bun build src/server/main.ts --target=node --outfile=dist/relay.js",
    "start": "bun dist/relay.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cloudflare.json",
    "test": "bun test",
    "cf:dev": "bunx wrangler dev",
    "cf:deploy": "bunx wrangler deploy"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "@notes-hq/protocol": "0.1.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
