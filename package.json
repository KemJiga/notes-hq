{
  "name": "notes-hq",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first notes that sync across your own devices through a relay you host.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@notes-hq/relay' --filter '@notes-hq/web' dev",
    "dev:web": "bun run --filter '@notes-hq/web' dev",
    "dev:relay": "bun run --filter '@notes-hq/relay' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4"
  }
}
